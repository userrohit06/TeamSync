## -----------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.opened

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

## -----------------------------------------
## Secrets & Environment Configurations
## -----------------------------------------
# Local appsettings overrides containing real database strings/API keys
appsettings.Development.json
appsettings.Local.json

# If you use dotenv files for configuration strings
.env
.env.*
!.env.example

## -----------------------------------------
## Dependency Management
## -----------------------------------------
# Paket dependency manager
.paket/

# Node modules (if you bundle a frontend spa or use tailwind/postcss tools)
node_modules/

