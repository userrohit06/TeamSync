##     Standard .NET Core / Visual Studio .gitignore template
## =======================================================================

# Build outputs and binaries
[Bb]in/
[Oo]bj/
[Ex]e/
[Dd]ll/
*.pdb
*.suo

# ASP.NET Core specific exclusions
appsettings.Development.json
# Note: Keep appsettings.json tracked for production defaults, 
# but ignore environment overrides if they contain local database passwords.
# appsettings.Local.json

# User-specific files and settings
*.user
*.userosscache
*.sln.docstates

# Visual Studio / Rider / VS Code IDE Cache and Settings
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.suo
*.clw

# Test results and coverage reports
[Tt]est[Rr]esults/
*.xunit
*.sequenced
_NCrunch_*
.*crunch*.config
ncrunch*.log

# NuGet Packages & Artifacts
*.nuget.props
*.nuget.targets
packages/
project.lock.json
project.fragment.lock.json

# Local Publish outputs
*.Publish.xml
*.pubxml
*.pubxml.user

# Logging and diagnostics
*.log
Logs/
App_Data/jobs/
App_Data/logs/

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db

# Frontend dependencies (if doing a shared SPA/Web API architecture)
node_modules/
/dist/
.bak
