{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DB_CONNECTION"
  },

  "FileSettings": {
    "MaxProfilePhotoSizeInBytes": 5242880
  },

  "JwtSettings": {
    "SecretKey": "YOUR_SECRET_KEY",
    "Issuer": "TeamSyncAPI",
    "Audience": "TeamSyncApp",
    "DurationInMinutes": 60
  },

  "AllowedOrigins": ["FRONTEND_URL"],

  "EmailSettings": {
    "SmtpServer": "://gmail.com",
    "Port": 587,
    "SenderName": "TeamSync",
    "SenderEmail": "YOUR_SENDER_EMAIL",
    "AppPassword": "YOUR_APP_PASSWORD"
  },

  "Google": {
    "ClientId": "YOUR_CLIENT_ID"
  },

  "ClientSettings": {
    "BaseUrl": "YOUR_CLIENT_URL"
  }
}
